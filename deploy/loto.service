[Unit]
Description=Loto Tir Tartegnin – prévente (FastAPI)
After=network.target

[Service]
User=loto
WorkingDirectory=/opt/loto/backend
EnvironmentFile=/opt/loto/backend/.env
ExecStart=/opt/loto/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8011
Restart=on-failure

[Install]
WantedBy=multi-user.target
